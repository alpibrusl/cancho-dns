edition 5;

module access;

// `access` -- the networks this binary serves, compiled in (`docs/design.md` section 16). Generated by `tests/gen_access.py` from
// the configuration; do not edit by hand. A client outside every prefix is refused.

pub fn count() -> [] int {
    return 1;
}

pub fn network(i: int) -> [] int {
    if i == 0 {
        return 2130706432;
    }
    return 0;
}

pub fn mask(i: int) -> [] int {
    if i == 0 {
        return 4278190080;
    }
    return 0;
}

// Does the IPv4 address `address` (a 32-bit number, first octet highest) fall inside a prefix?
pub fn allowed(address: int) -> [] bool {
    var i = 0;
    while i < count() {
        if address & mask(i) == network(i) {
            return true;
        }
        i = i + 1;
    }
    return false;
}
