edition 5;

import std.io;
import dns;

// A test driver for `tests/differential_codec.py`: reads one message per line as hex on standard input, parses it
// with `dns.parse`, and prints one line per message -- `OK` and what was found, or `ERR`, the code and the rule tag.
// It is the codec behind a pipe, nothing more; the resolver does not use it.
//
//     OK <id> <flags> <qd> <an> <ns> <ar> <qtype> <qclass> <qname hex> <opt index> <udp size> <ext rcode> <version> <edns flags>
//        then one group per record:  | <type> <class> <ttl> <rdata length> <rdata offset> <owner name hex>

fn hexval(c: int) -> [] int {
    if c >= '0' && c <= '9' {
        return c - '0';
    }
    if c >= 'a' && c <= 'f' {
        return c - 'a' + 10;
    }
    if c >= 'A' && c <= 'F' {
        return c - 'A' + 10;
    }
    return 0 - 1;
}

fn digit(v: int) -> [] int {
    if v < 10 {
        return '0' + v;
    }
    return 'a' + v - 10;
}

fn print_hex[&i, &d](io: &!i Io, data: &d [byte]) -> [io_write] int {
    var k = 0;
    while k < len(data) {
        let v = int_of(data[k]);
        putchar(io, digit(v / 16));
        putchar(io, digit(v % 16));
        k = k + 1;
    }
    return 0;
}

fn number[&i](io: &!i Io, n: int) -> [io_write] int {
    putchar(io, ' ');
    return io.print_int(io, n);
}

fn answer[&i, &d, &t](io: &!i Io, data: &d [byte], table: &!t [int]) -> [io_write] int {
    let r = dns.parse(data, table);
    if r < 0 {
        io.write_all(io, "ERR");
        number(io, r);
        putchar(io, ' ');
        io.write_all(io, dns.error_tag(r));
        io.newline(io);
        return 0;
    }
    io.write_all(io, "OK");
    var k = 0;
    while k < 6 {
        number(io, table[k]);
        k = k + 1;
    }
    number(io, table[7]);
    number(io, table[8]);
    region a {
        let name = alloc_slice[a](255, byte_of(0));
        putchar(io, ' ');
        let n = dns.name_expand(data, table[6], name);
        print_hex(io, name[0..n]);
        number(io, table[9]);
        number(io, table[10]);
        number(io, table[11]);
        number(io, table[12]);
        number(io, table[13]);
        var i = 0;
        let total = table[3] + table[4] + table[5];
        while i < total {
            let row = 14 + 6 * i;
            io.write_all(io, " |");
            number(io, table[row + 1]);
            number(io, table[row + 2]);
            number(io, table[row + 3]);
            number(io, table[row + 5]);
            number(io, table[row + 4]);
            putchar(io, ' ');
            let m = dns.name_expand(data, table[row], name);
            print_hex(io, name[0..m]);
            i = i + 1;
        }
    }
    io.newline(io);
    return 0;
}

fn run[&i](io: &!i Io) -> [io_read, io_write] int {
    var more = true;
    while more {
        region a {
            let data = alloc_slice[a](8192, byte_of(0));
            let table = alloc_slice[a](dns.slots(), 0);
            var n = 0;
            var high = 0 - 1;
            var c = getchar(io);
            while c >= 0 && c != '\n' {
                let v = hexval(c);
                if v >= 0 {
                    if high < 0 {
                        high = v;
                    } else {
                        if n < len(data) {
                            data[n] = byte_of(high * 16 + v);
                            n = n + 1;
                        }
                        high = 0 - 1;
                    }
                }
                c = getchar(io);
            }
            if c < 0 && n == 0 && high < 0 {
                more = false;
            } else {
                answer(io, data[0..n], table);
            }
        }
    }
    return 0;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    release(net);
    release(clock);
    release(ffi);
    release(fs);
    release(heap);
    release(args);
    var status = 0;
    borrow mut io as &!i in {
        status = run(i);
    }
    release(io);
    return status;
}
