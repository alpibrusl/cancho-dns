import std.test;
import dns;
import stub;

// The stub responder (`src/stub.cho`) against the codec: what it answers for each kind of query, how big, and when it
// truncates. Every reply is parsed back with `dns.parse`, so a reply that is not a well-formed message fails here.

fn put_label[&b, &s](buf: &!b [byte], at: int, s: &s [byte]) -> [] int {
    var p = dns.put8(buf, at, len(s));
    var i = 0;
    while i < len(s) {
        p = dns.put8(buf, p, int_of(s[i]));
        i = i + 1;
    }
    return p;
}

// A query for `<first>.example.com` of type `qtype` and class `qclass`, with the opcode and flags given, and an OPT record
// advertising `udp_size` (version `version`) unless `udp_size` is 0. Answers its length.
fn make_query[&b, &s](buf: &!b [byte], first: &s [byte], qtype: int, qclass: int, opcode: int, udp_size: int, version: int) -> [] int {
    var additional = 0;
    if udp_size > 0 {
        additional = 1;
    }
    var p = dns.put16(buf, 0, 4660);
    p = dns.put16(buf, p, opcode * 2048 + 256);
    p = dns.put16(buf, p, 1);
    p = dns.put16(buf, p, 0);
    p = dns.put16(buf, p, 0);
    p = dns.put16(buf, p, additional);
    p = put_label(buf, p, first);
    p = put_label(buf, p, "example");
    p = put_label(buf, p, "com");
    p = dns.put8(buf, p, 0);
    p = dns.put16(buf, p, qtype);
    p = dns.put16(buf, p, qclass);
    if udp_size > 0 {
        p = dns.put8(buf, p, 0);
        p = dns.put16(buf, p, 41);
        p = dns.put16(buf, p, udp_size);
        p = dns.put32(buf, p, version * 65536);
        p = dns.put16(buf, p, 0);
    }
    return p;
}

// Respond to a query built by `make_query`; answers the reply's length and leaves it parsed in `reply_table`.
fn ask[&a, &r](first: &a [byte], qtype: int, qclass: int, opcode: int, udp_size: int, version: int, limit: int, reply_table: &!r [int]) -> [] int {
    var n = 0;
    region r {
        let table = alloc_slice[r](dns.slots(), 0);
        let data = alloc_slice[r](512, byte_of(0));
        let out = alloc_slice[r](stub.largest(), byte_of(0));
        let size = make_query(data, first, qtype, qclass, opcode, udp_size, version);
        test.assert_eq(dns.parse(data[0..size], table), size);
        let used = stub.respond(out, data[0..size], table, limit);
        test.assert(used > 0);
        test.assert_eq(dns.parse(out[0..used], reply_table), used);
        n = used;
    }
    return n;
}

fn flags_of[&t](table: &t [int]) -> [] int {
    return table[1];
}

fn test_a_name_gets_one_a_record_and_n_names_get_n() -> [] int {
    region a {
        let reply = alloc_slice[a](dns.slots(), 0);
        ask("www", 1, 1, 0, 0, 0, 0, reply);
        test.assert_eq(reply[3], 1);
        ask("n40", 1, 1, 0, 0, 0, 0, reply);
        test.assert_eq(reply[3], 40);
        // The cap: 64 records.
        ask("n99", 1, 1, 0, 0, 0, 0, reply);
        test.assert_eq(reply[3], 64);
        // `n` alone and `nx` are ordinary names.
        ask("n", 1, 1, 0, 0, 0, 0, reply);
        test.assert_eq(reply[3], 1);
        ask("n4x", 1, 1, 0, 0, 0, 0, reply);
        test.assert_eq(reply[3], 1);
        // QR, the recursion bit of the query, RA, RCODE 0; the id is the query's.
        test.assert_eq(reply[0], 4660);
        test.assert_eq(flags_of(reply), 32768 + 256 + 128);
        // An address is `192.0.2.k`.
        test.assert_eq(reply[14 + 6 * 0 + 1], 1);
    }
    return 0;
}

fn test_other_types_get_no_data_and_txt_gets_its_size() -> [] int {
    region a {
        let reply = alloc_slice[a](dns.slots(), 0);
        // AAAA, and TXT for an ordinary name: NOERROR with no records.
        ask("www", 28, 1, 0, 0, 0, 0, reply);
        test.assert_eq(reply[3], 0);
        test.assert_eq(flags_of(reply) % 16, 0);
        ask("www", 16, 1, 0, 0, 0, 0, reply);
        test.assert_eq(reply[3], 0);
        // TXT for `t300`: one record of 300 bytes in two strings (255 and 45): 302 bytes of data.
        ask("t300", 16, 1, 0, 0, 0, 0, reply);
        test.assert_eq(reply[3], 1);
        test.assert_eq(reply[14 + 5], 302);
    }
    return 0;
}

fn test_a_reply_over_the_limit_is_truncated_to_the_question() -> [] int {
    region a {
        let reply = alloc_slice[a](dns.slots(), 0);
        // The question is 12 + 17 + 4 = 33 bytes; 40 A records add 640: 673 in all, over 512 so TC, under 1232 so whole.
        let cut = ask("n40", 1, 1, 0, 0, 0, 512, reply);
        test.assert_eq(flags_of(reply) / 512 % 2, 1);
        test.assert_eq(reply[3], 0);
        test.assert_eq(cut, 33);
        let whole = ask("n40", 1, 1, 0, 0, 0, 1232, reply);
        test.assert_eq(flags_of(reply) / 512 % 2, 0);
        test.assert_eq(reply[3], 40);
        test.assert_eq(whole, 33 + 640);
        // No limit: whole, as TCP is.
        ask("n40", 1, 1, 0, 0, 0, 0, reply);
        test.assert_eq(reply[3], 40);
        // The edge: a limit of exactly the size is not truncated; one less is.
        ask("n40", 1, 1, 0, 0, 0, 673, reply);
        test.assert_eq(reply[3], 40);
        ask("n40", 1, 1, 0, 0, 0, 672, reply);
        test.assert_eq(reply[3], 0);
        // The truncated reply keeps the OPT record when the query had one: 11 bytes more.
        let with_opt = ask("n40", 1, 1, 0, 4096, 0, 512, reply);
        test.assert_eq(with_opt, 33 + 11);
        test.assert_eq(reply[9], 0);
    }
    return 0;
}

fn test_the_udp_limit_is_what_the_client_advertised_between_512_and_1232() -> [] int {
    region a {
        let table = alloc_slice[a](dns.slots(), 0);
        let data = alloc_slice[a](512, byte_of(0));
        var size = make_query(data, "www", 1, 1, 0, 0, 0);
        test.assert_eq(dns.parse(data[0..size], table), size);
        test.assert_eq(stub.udp_limit(table), 512);
        size = make_query(data, "www", 1, 1, 0, 100, 0);
        test.assert_eq(dns.parse(data[0..size], table), size);
        test.assert_eq(stub.udp_limit(table), 512);
        size = make_query(data, "www", 1, 1, 0, 900, 0);
        test.assert_eq(dns.parse(data[0..size], table), size);
        test.assert_eq(stub.udp_limit(table), 900);
        size = make_query(data, "www", 1, 1, 0, 4096, 0);
        test.assert_eq(dns.parse(data[0..size], table), size);
        test.assert_eq(stub.udp_limit(table), 1232);
    }
    return 0;
}

fn test_a_1300_byte_txt_is_truncated_even_for_a_client_that_asks_for_4096() -> [] int {
    region a {
        let table = alloc_slice[a](dns.slots(), 0);
        let reply = alloc_slice[a](dns.slots(), 0);
        let data = alloc_slice[a](512, byte_of(0));
        let size = make_query(data, "t1300", 16, 1, 0, 4096, 0);
        test.assert_eq(dns.parse(data[0..size], table), size);
        let limit = stub.udp_limit(table);
        test.assert_eq(limit, 1232);
        let out = alloc_slice[a](stub.largest(), byte_of(0));
        let used = stub.respond(out, data[0..size], table, limit);
        test.assert_eq(dns.parse(out[0..used], reply), used);
        test.assert_eq(reply[3], 0);
        test.assert_eq(reply[1] / 512 % 2, 1);
        // Over TCP, with no limit, the whole 1300 bytes (and 6 string lengths: 1306 bytes of data).
        let whole = stub.respond(out, data[0..size], table, 0);
        test.assert_eq(dns.parse(out[0..whole], reply), whole);
        test.assert_eq(reply[3], 1);
        test.assert_eq(reply[14 + 5], 1306);
    }
    return 0;
}

fn test_what_it_refuses_and_with_which_rcode() -> [] int {
    region a {
        let reply = alloc_slice[a](dns.slots(), 0);
        // An opcode other than QUERY: NOTIMP (4).
        ask("www", 1, 1, 1, 0, 0, 0, reply);
        test.assert_eq(reply[1] % 16, 4);
        // A class other than IN: REFUSED (5). So are AXFR (252) and IXFR (251).
        ask("www", 1, 3, 0, 0, 0, 0, reply);
        test.assert_eq(reply[1] % 16, 5);
        ask("www", 252, 1, 0, 0, 0, 0, reply);
        test.assert_eq(reply[1] % 16, 5);
        ask("www", 251, 1, 0, 0, 0, 0, reply);
        test.assert_eq(reply[1] % 16, 5);
        // EDNS version 1: BADVERS (16): RCODE 0 in the header, the high bits (1) in the OPT record.
        ask("www", 1, 1, 0, 1232, 1, 0, reply);
        test.assert_eq(reply[1] % 16, 0);
        test.assert_eq(reply[11], 1);
        test.assert_eq(reply[3], 0);
        // EDNS version 0 is fine.
        ask("www", 1, 1, 0, 1232, 0, 0, reply);
        test.assert_eq(reply[3], 1);
        test.assert_eq(reply[11], 0);
    }
    return 0;
}

fn test_a_buffer_too_small_is_an_error_not_a_trap() -> [] int {
    region a {
        let table = alloc_slice[a](dns.slots(), 0);
        let data = alloc_slice[a](512, byte_of(0));
        let size = make_query(data, "n64", 1, 1, 0, 0, 0);
        test.assert_eq(dns.parse(data[0..size], table), size);
        let small = alloc_slice[a](100, byte_of(0));
        test.assert_eq(stub.respond(small, data[0..size], table, 0), dns.error_no_room());
    }
    return 0;
}
